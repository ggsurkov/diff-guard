+<script lang="ts">
+  export let title: string = "Card";
+  export let isOpen: boolean = false;
+
+  function toggle(): void {
+    isOpen = !isOpen;
+  }
+</script>
+
+<button on:click={toggle}>{title}</button>
+
+<div class="card" class:card--open={isOpen}>
+  <div class="card__slider"></div>
+  <p>Some content that slides in from the side.</p>
+</div>
+
+<style>
+  .card {
+    position: relative;
+    overflow: hidden;
+    height: 0;
+    transition: height 0.3s ease;
+  }
+
+  .card--open {
+    height: 160px;
+  }
+
+  .card__slider {
+    position: absolute;
+    top: 0;
+    width: 40px;
+    margin-left: 0;
+    background: #4f8cff;
+    transition: margin-left 0.4s ease, width 0.4s ease;
+  }
+
+  .card--open .card__slider {
+    margin-left: calc(100% - 40px);
+    width: 80px;
+  }
+</style>
